{
  "name": "care-taker",
  "version": "0.1.0",
  "private": true,
  "description": "Voice-first hospital after-care prototype for India",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/copy-assets.js && node server/index.js",
    "dev": "node scripts/copy-assets.js && node --watch server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "postinstall": "node scripts/copy-assets.js",
    "smoke": "node scripts/smoke.js",
    "review-sheet": "node scripts/review-sheet.js"
  },
  "dependencies": {
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-gujarati": "^5.3.0",
    "@fontsource/noto-sans-gurmukhi": "^5.3.0",
    "@fontsource/noto-sans-kannada": "^5.3.0",
    "@fontsource/noto-sans-malayalam": "^5.3.0",
    "@fontsource/noto-sans-oriya": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "@fontsource/noto-sans-telugu": "^5.3.0",
    "express": "^4.21.2",
    "lenis": "^1.3.29"
  }
}
