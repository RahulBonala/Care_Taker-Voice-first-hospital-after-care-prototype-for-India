# Every variable is optional. Care Taker runs with none of them set.
# Copy to .env and fill in only what you want to try. Never commit .env.

# Sarvam AI speech for Indian languages (text to speech and speech to text)
SARVAM_API_KEY=your-sarvam-key-here
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_STT_MODEL=saarika:v2
SARVAM_SPEAKER=anushka

# Twilio, for a real phone call instead of the on-screen phone
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM=+10000000000
# Public HTTPS address of this app, so Twilio can reach the speech webhooks
PUBLIC_URL=https://your-public-url.example

# Optional model that suggests an intent for misheard replies (Anthropic Messages API by default)
LLM_API_KEY=your-llm-key-here
LLM_MODEL=claude-haiku-5-5
LLM_API_URL=https://api.anthropic.com/v1/messages

# Server
PORT=3000
DATA_DIR=./data
